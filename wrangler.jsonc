{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-2026",
  "compatibility_date": "2026-09-01",
  // Static site: serve the repo root as-is, no build step.
  "assets": {
    "directory": "./",
    // Serves /contact from contact.html and redirects /contact.html to /contact
    // (clean URLs without .html and without a trailing slash).
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
